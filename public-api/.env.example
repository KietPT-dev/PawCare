# Database
PAWCARE_DB_URL=jdbc:mysql://localhost:3306/pawcare?useUnicode=true&characterEncoding=utf8&serverTimezone=Asia/Ho_Chi_Minh
PAWCARE_DB_USERNAME=pawcare_app
PAWCARE_DB_PASSWORD=replace_with_database_password

# Run once: openssl rand -base64 48
PAWCARE_JWT_SECRET=replace_with_random_base64_secret
PAWCARE_JWT_ISSUER=pawcare-public-api

# Comma-separated. Keep local wildcards only in development; set explicit
# HTTPS origins (for example https://app.pawcare.vn) in production.
PAWCARE_CORS_ORIGIN_PATTERNS=http://localhost:*,http://127.0.0.1:*

# VNPAY Sandbox credentials: never commit real values.
VNPAY_ENABLED=true
VNPAY_TMN_CODE=replace_with_sandbox_tmn_code
VNPAY_HASH_SECRET=replace_with_sandbox_hash_secret
VNPAY_RETURN_URL=https://your-public-https-domain/api/v1/payments/vnpay/return
VNPAY_IPN_URL=https://your-public-https-domain/api/v1/payments/vnpay/ipn
